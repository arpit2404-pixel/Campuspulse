# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore, so it is never uploaded to GitHub.
# Never put real secrets in this example file.

# ---------------- Server (secret) ----------------

# Your Neon connection string (Neon dashboard -> Connect). It looks like:
# postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# A long random string (32+ characters). Used to make anonymous "device" hashes.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SECRET=

# Port for the API server (default 3001)
PORT=3001

# Only needed when the website is hosted at a DIFFERENT address than this server.
# Comma-separated list of website addresses allowed to call the API.
# Example: https://campuspulse.netlify.app
CORS_ORIGIN=http://localhost:3000

# ---------------- Website (public) ----------------
# Anything starting with VITE_ is built into the website and visible to everyone.
# NEVER put a password, secret or database URL in a VITE_ variable.

# Address of the API. Leave empty when the website and API run on the same server
# (and while developing locally, where Vite forwards /api to port 3001).
VITE_API_URL=
